<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>63bd35e4-188e-47c8-9e93-ecbc385a89b6</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Identity.Web" Version="4.16.1" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- No lo usamos directamente: lo traen Microsoft.Identity.Web y otras librerías en una versión con
         vulnerabilidades (CVE-2026-84008, CVE-2026-70162). Se fija la versión corregida; se puede quitar cuando
         esas librerías ya traigan la 10.0.13 o superior. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MafTi.Application\MafTi.Application.csproj" />
    <ProjectReference Include="..\MafTi.Infrastructure\MafTi.Infrastructure.csproj" />
  </ItemGroup>

</Project>
